<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-bold">Админы</h1>
  <%= link_to "Добавить админа", new_admin_admin_user_path, class: "inline-flex items-center justify-center rounded bg-gray-900 px-4 py-2 text-sm text-white hover:bg-gray-700" %>
</div>

<div class="space-y-3">
  <% @admin_users.each do |admin_user| %>
    <div class="flex items-center justify-between rounded border border-gray-200 bg-white px-4 py-3">
      <div class="min-w-0">
        <h2 class="font-bold text-lg">
          <%= admin_user.login %>
          <% if admin_user == current_admin %><span class="text-xs text-gray-400">(вы)</span><% end %>
        </h2>
        <p class="text-sm text-gray-500">
          <% if admin_user.superadmin? %>
            Супер-админ · все города
          <% else %>
            Города: <%= admin_user.cities.map(&:name).join(", ").presence || "—" %>
          <% end %>
        </p>
      </div>
      <div class="flex shrink-0 items-center gap-3">
        <%= link_to "Ред.", edit_admin_admin_user_path(admin_user), class: "text-sm text-blue-600 hover:underline" %>
        <% unless admin_user == current_admin %>
          <%= button_to "Удалить", admin_admin_user_path(admin_user), method: :delete,
              form: { data: { turbo_confirm: "Удалить админа «#{admin_user.login}»?" } },
              class: "text-sm text-red-600 hover:underline bg-transparent border-0 p-0 cursor-pointer" %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
