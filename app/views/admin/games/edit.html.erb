<div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
  <h1 class="text-2xl font-bold">Тур <%= @tour.number %> — Стол <%= @game.table_letter %></h1>
  <%= link_to "← Назад", admin_tour_path(@tour), class: "text-sm text-gray-500 hover:text-gray-700" %>
</div>

<%= form_with model: @game, url: admin_tour_game_path(@tour, @game), method: :patch, class: "overflow-hidden rounded-lg bg-white shadow", data: { controller: "points-calculator slot-toggle" } do |f| %>
  <div class="hidden border-b bg-gray-50 px-4 py-3 text-sm font-semibold text-gray-700 lg:grid lg:grid-cols-[minmax(12rem,1.8fr)_minmax(10rem,1.3fr)_5rem_5rem_5rem_5rem_6rem_5rem] lg:gap-3">
    <div>Игрок</div>
    <div>Дом</div>
    <div class="text-center">Место</div>
    <div class="text-center">Столицы</div>
    <div class="text-center">Драконы</div>
    <div class="text-center">Замки</div>
    <div class="text-center">Подсказка</div>
    <div class="text-center">Очки</div>
  </div>

  <div class="divide-y divide-gray-200">
    <% @game.game_results.each_with_index do |gr, i| %>
      <%= f.fields_for "game_results_attributes[]", gr, index: i do |grf| %>
        <div class="<%= 'bg-gray-50 opacity-50' unless gr.player_id.present? %> p-4" data-points-calculator-target="row" data-slot-toggle-target="row">
          <%= grf.hidden_field :id if gr.persisted? %>

          <div class="grid grid-cols-2 gap-3 lg:grid-cols-[minmax(12rem,1.8fr)_minmax(10rem,1.3fr)_5rem_5rem_5rem_5rem_6rem_5rem] lg:items-center">
            <div class="col-span-2 lg:col-span-1">
              <label class="mb-1 block text-xs font-medium uppercase tracking-wide text-gray-500 lg:hidden">Игрок</label>
              <%= grf.select :player_id,
                  options_for_select(@player_options, gr.player_id),
                  { include_blank: "— свободный слот —" },
                  class: "w-full min-w-0 rounded border border-gray-300 px-3 py-2 text-sm",
                  data: { action: "change->slot-toggle#toggle", slot_toggle_target: "select" } %>
            </div>

            <div class="col-span-2 lg:col-span-1">
              <label class="mb-1 block text-xs font-medium uppercase tracking-wide text-gray-500 lg:hidden">Дом</label>
              <%= grf.select :house,
                  options_for_select(@house_options, gr.house),
                  { include_blank: "— дом —" },
                  class: "w-full min-w-0 rounded border border-gray-300 px-3 py-2 text-sm" %>
            </div>

            <div>
              <label class="mb-1 block text-xs font-medium uppercase tracking-wide text-gray-500 lg:hidden">Место</label>
              <%= grf.number_field :place, min: 1, max: 8, class: "w-full rounded border border-gray-300 px-3 py-2 text-center text-sm",
                  data: { action: "input->points-calculator#calculate", points_calculator_target: "place" } %>
            </div>

            <div>
              <label class="mb-1 block text-xs font-medium uppercase tracking-wide text-gray-500 lg:hidden">Столицы</label>
              <%= grf.number_field :capitals, min: 0, value: gr.capitals || 0, class: "w-full rounded border border-gray-300 px-3 py-2 text-center text-sm",
                  data: { action: "input->points-calculator#calculate", points_calculator_target: "capitals" } %>
            </div>

            <div>
              <label class="mb-1 block text-xs font-medium uppercase tracking-wide text-gray-500 lg:hidden">Драконы</label>
              <%= grf.number_field :dragons, min: 0, value: gr.dragons || 0, class: "w-full rounded border border-gray-300 px-3 py-2 text-center text-sm",
                  data: { action: "input->points-calculator#calculate", points_calculator_target: "dragons" } %>
            </div>

            <div>
              <label class="mb-1 block text-xs font-medium uppercase tracking-wide text-gray-500 lg:hidden">Замки</label>
              <%= grf.number_field :castles, min: 0, value: gr.castles || 0, class: "w-full rounded border border-gray-300 px-3 py-2 text-center text-sm",
                  data: { action: "input->points-calculator#calculate", points_calculator_target: "castles" } %>
            </div>

            <div>
              <label class="mb-1 block text-xs font-medium uppercase tracking-wide text-gray-500 lg:hidden">Подсказка</label>
              <div class="flex h-[42px] items-center justify-center rounded border border-dashed border-gray-300 bg-gray-50 px-2 text-sm text-gray-500" data-points-calculator-target="suggested">
                <%= gr.persisted? && gr.place ? gr.suggested_points : "—" %>
              </div>
            </div>

            <div>
              <label class="mb-1 block text-xs font-medium uppercase tracking-wide text-gray-500 lg:hidden">Очки</label>
              <%= grf.number_field :points, class: "w-full rounded border border-gray-300 px-3 py-2 text-center text-sm font-bold",
                  data: { points_calculator_target: "points" } %>
            </div>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>

  <div class="border-t px-4 py-4">
    <%= f.submit "Сохранить результаты", class: "w-full cursor-pointer rounded bg-gray-900 px-6 py-2 text-white hover:bg-gray-700 sm:w-auto" %>
  </div>
<% end %>
