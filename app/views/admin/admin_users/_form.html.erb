<%= form_with model: [:admin, admin_user], class: "space-y-4 max-w-lg" do |f| %>
  <% if admin_user.errors.any? %>
    <div class="bg-red-100 border border-red-300 text-red-800 px-4 py-2 rounded">
      <% admin_user.errors.full_messages.each do |msg| %>
        <p><%= msg %></p>
      <% end %>
    </div>
  <% end %>

  <div>
    <%= f.label :login, "Логин", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_field :login, class: "w-full border border-gray-300 rounded px-3 py-2" %>
  </div>

  <div>
    <%= f.label :password, "Пароль", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.password_field :password, autocomplete: "new-password", class: "w-full border border-gray-300 rounded px-3 py-2" %>
    <% if admin_user.persisted? %>
      <p class="mt-1 text-xs text-gray-400">Оставьте пустым, чтобы не менять пароль.</p>
    <% end %>
  </div>

  <div>
    <%= f.label :password_confirmation, "Повторите пароль", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "w-full border border-gray-300 rounded px-3 py-2" %>
  </div>

  <div class="rounded border border-gray-200 bg-gray-50 px-4 py-3">
    <label class="flex items-start gap-3">
      <%= f.check_box :superadmin, class: "mt-1 h-4 w-4 rounded border-gray-300" %>
      <span>
        <span class="block text-sm font-medium text-gray-700">Супер-админ</span>
        <span class="block text-xs text-gray-500">Полный доступ ко всем городам и управлению админами.</span>
      </span>
    </label>
  </div>

  <div class="rounded border border-gray-200 bg-gray-50 px-4 py-3">
    <span class="block text-sm font-medium text-gray-700 mb-2">Города (для обычного админа)</span>
    <div class="flex flex-wrap gap-x-6 gap-y-2">
      <%= f.collection_check_boxes :city_ids, City.ordered, :id, :name do |b| %>
        <label class="flex items-center gap-2">
          <%= b.check_box class: "h-4 w-4 rounded border-gray-300" %>
          <span class="text-sm text-gray-700"><%= b.object.name %></span>
        </label>
      <% end %>
    </div>
    <p class="mt-2 text-xs text-gray-500">Обычный админ управляет турами, играми, страницами и игроками только выбранных городов. Для супер-админа не требуется.</p>
  </div>

  <div>
    <%= f.submit class: "bg-gray-900 text-white px-6 py-2 rounded hover:bg-gray-700 cursor-pointer" %>
  </div>
<% end %>
