<!DOCTYPE html>
<html>
  <head>
    <title>Админ — Игра Престолов</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-gray-50 min-h-screen">
    <nav class="bg-gray-900 text-white">
      <div class="max-w-5xl mx-auto px-4 py-3 flex items-center justify-between">
        <div class="flex items-center gap-6">
          <span class="font-bold text-lg">⚔️ Админ-панель</span>
          <% if current_admin %>
            <%= link_to "Игроки", admin_players_path, class: "hover:text-yellow-300 text-sm" %>
            <%= link_to "Туры", admin_tours_path, class: "hover:text-yellow-300 text-sm" %>
            <%= link_to "Правила", admin_edit_page_path("rules"), class: "hover:text-yellow-300 text-sm" %>
            <%= link_to "← На сайт", root_path, class: "hover:text-yellow-300 text-sm" %>
          <% end %>
        </div>
        <% if current_admin %>
          <%= button_to "Выйти", admin_logout_path, method: :delete, class: "text-sm text-red-300 hover:text-red-100" %>
        <% end %>
      </div>
    </nav>

    <div class="max-w-5xl mx-auto px-4 py-6">
      <% if flash[:notice] %>
        <div class="bg-green-100 border border-green-300 text-green-800 px-4 py-2 rounded mb-4"><%= flash[:notice] %></div>
      <% end %>
      <% if flash[:alert] %>
        <div class="bg-red-100 border border-red-300 text-red-800 px-4 py-2 rounded mb-4"><%= flash[:alert] %></div>
      <% end %>

      <%= yield %>
    </div>
  </body>
</html>
