<div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
  <h1 class="text-2xl font-bold">Тур <%= @tour.number %> — Стол <%= @game.table_letter %></h1>
  <%= link_to "← Назад", admin_tour_path(@tour), class: "text-sm text-gray-500 hover:text-gray-700" %>
</div>

<%= form_with model: @game,
    url: admin_tour_game_path(@tour, @game),
    method: :patch,
    class: "overflow-hidden rounded-lg bg-white shadow",
    data: {
      controller: "points-calculator slot-toggle",
      action: "submit->slot-toggle#validateBeforeSubmit",
      points_calculator_table_letter_value: @game.table_letter,
      points_calculator_format_value: @tour.game_format.to_config_json,
      slot_toggle_all_player_options_value: @player_options.to_json,
      slot_toggle_player_tour_table_warnings_value: @player_tour_table_warnings.to_json,
      slot_toggle_all_house_options_value: @house_options.to_json,
      slot_toggle_player_house_options_value: @player_house_options.to_json,
      slot_toggle_house_reuse_allowed_value: @house_reuse_allowed,
      slot_toggle_player_historical_houses_value: @player_historical_houses.to_json
    } do |f| %>
  <%# Классика скрывает «Черепки» и «Драконы» → в lg-сетке 7 столбцов вместо 9.
      Tailwind не понимает arbitrary-значения с интерполяцией, поэтому оба класса — литералы. %>
  <% grid_cols = @tour.game_format.tracks_dragons? ?
       "lg:grid-cols-[minmax(9rem,1.7fr)_minmax(8rem,1.2fr)_repeat(9,minmax(3.75rem,0.72fr))]" :
       "lg:grid-cols-[minmax(9rem,1.7fr)_minmax(8rem,1.2fr)_repeat(7,minmax(3.75rem,0.72fr))]" %>
  <div class="hidden border-b bg-gray-50 px-4 py-3 text-sm font-semibold text-gray-700 lg:grid <%= grid_cols %> lg:items-center lg:gap-3">
    <div>Игрок</div>
    <div>Дом</div>
    <div class="text-center">Место</div>
    <div class="text-center">Захваты</div>
    <div class="text-center">Контроль столиц</div>
    <div class="text-center">Земли</div>
    <% if @tour.game_format.tracks_skulls? %>
      <div class="text-center">Черепки</div>
    <% end %>
    <% if @tour.game_format.tracks_dragons? %>
      <div class="text-center">Драконы</div>
    <% end %>
    <div class="text-center">Замки</div>
    <div class="text-center">Подсказка</div>
    <div class="text-center">Очки</div>
  </div>

  <div class="divide-y divide-gray-200">
    <% @game.game_results.each_with_index do |gr, i| %>
      <%= f.fields_for "game_results_attributes[]", gr, index: i do |grf| %>
        <% row_player_options = @player_options_by_selected.fetch(gr.player_id.to_s, @player_options_by_selected.fetch("")) %>
        <% row_player_label = row_player_options.find { |(_label, player_id)| player_id.to_s == gr.player_id.to_s }&.first %>
        <% warning_tables = @player_tour_table_warnings.fetch(gr.player_id.to_s, []) %>
        <% player_warning = warning_tables.any? ? "Уже играет в этом туре: #{warning_tables.map { |table_letter| "стол #{table_letter}" }.join(', ')}" : "" %>
        <% row_house_options = gr.player_id.present? ? @player_house_options.fetch(gr.player_id.to_s, @house_options) : @house_options %>
        <% historical_houses = @player_historical_houses.fetch(gr.player_id.to_s, []) %>
        <% display_house_options = row_house_options.map do |label, house|
             historical_houses.include?(house) ? ["#{label} — уже играл", house] : [label, house]
           end %>
        <% repeated_house = gr.house.present? && historical_houses.include?(gr.house) %>
        <% house_hint = if gr.player_id.present?
             if repeated_house
               "Внимание: игрок уже играл за дом «#{GameResult::HOUSE_LABELS.fetch(gr.house)}». В заключительном туре повтор разрешён."
             elsif @house_reuse_allowed
               "Заключительный тур: можно повторить дом; ранее использованные дома отмечены «уже играл»."
             elsif row_house_options.any?
               "Можно выбрать: #{row_house_options.map(&:first).join(', ')}"
             else
               "У этого игрока не осталось свободных домов"
             end
           else
             "Сначала выберите игрока"
           end %>
        <div class="<%= 'bg-gray-50' unless gr.player_id.present? %> p-4" data-points-calculator-target="row" data-slot-toggle-target="row">
          <%= grf.hidden_field :id if gr.persisted? %>
          <%= grf.hidden_field :capitals,
              value: gr.capitals || 0,
              data: { points_calculator_target: "legacyCapitals" } %>

          <div class="grid grid-cols-2 gap-3 <%= grid_cols %> lg:items-start">
            <div class="col-span-2 min-w-0 lg:col-span-1">
              <label class="mb-1 block text-xs font-medium uppercase tracking-wide text-gray-500 lg:hidden">Игрок</label>
              <div class="relative" data-slot-toggle-target="playerCombobox">
                <% listbox_id = "player_options_#{i}" %>
                <%= text_field_tag nil,
                    row_player_label,
                    class: "h-12 w-full min-w-0 rounded border border-gray-300 px-3 text-sm leading-5",
                    placeholder: "— свободный слот —",
                    autocomplete: "off",
                    role: "combobox",
                    aria: { autocomplete: "list", expanded: "false", controls: listbox_id },
                    data: {
                      action: "click->slot-toggle#openPlayerMenu input->slot-toggle#filterPlayers focus->slot-toggle#openPlayerMenu keydown->slot-toggle#handlePlayerInputKeydown",
                      slot_toggle_target: "playerInput"
                    } %>
                <div id="<%= listbox_id %>"
                     class="absolute z-20 mt-1 hidden max-h-56 w-full overflow-y-auto rounded border border-gray-300 bg-white shadow"
                     role="listbox"
                     data-slot-toggle-target="playerMenu"></div>
              </div>
              <%= grf.select :player_id,
                  options_for_select(row_player_options, gr.player_id),
                  { include_blank: "— свободный слот —" },
                  class: "hidden",
                  data: { action: "change->slot-toggle#refresh", slot_toggle_target: "playerSelect" } %>
              <p class="mt-1 min-h-[1.25rem] text-xs text-amber-700" data-slot-toggle-target="playerWarning"><%= player_warning %></p>
            </div>

            <div class="col-span-2 min-w-0 lg:col-span-1">
              <label class="mb-1 block text-xs font-medium uppercase tracking-wide text-gray-500 lg:hidden">Дом</label>
              <%= grf.select :house,
                  options_for_select(display_house_options, gr.house),
                  { include_blank: "— дом —" },
                  class: "h-12 w-full min-w-0 rounded border border-gray-300 px-3 text-sm leading-5 disabled:cursor-not-allowed disabled:bg-gray-100 disabled:text-gray-400",
                  disabled: gr.player_id.blank?,
                  data: { action: "change->slot-toggle#refresh", slot_toggle_target: "houseSelect" } %>
              <p class="mt-1 min-h-[3.75rem] text-xs <%= repeated_house ? 'font-medium text-amber-700' : 'text-gray-500' %>"
                 aria-live="polite"
                 data-slot-toggle-target="houseHint"><%= house_hint %></p>
            </div>

            <div class="min-w-0">
              <label class="mb-1 block text-xs font-medium uppercase tracking-wide text-gray-500 lg:hidden">Место</label>
              <%= grf.number_field :place, min: 1, max: @tour.game_format.place_range.max, class: "h-12 w-full rounded border border-gray-300 px-3 text-center text-sm leading-5",
                  data: { action: "input->points-calculator#calculate", points_calculator_target: "place" } %>
            </div>

            <div class="min-w-0">
              <label class="mb-1 block text-xs font-medium uppercase tracking-wide text-gray-500 lg:hidden">Захваты</label>
              <%= grf.number_field :capital_captures, min: 0, class: "h-12 w-full rounded border border-gray-300 px-3 text-center text-sm leading-5",
                  data: { action: "input->points-calculator#calculate", points_calculator_target: "capitalCaptures" } %>
            </div>

            <div class="min-w-0">
              <label class="mb-1 block text-xs font-medium uppercase tracking-wide text-gray-500 lg:hidden">Контроль столиц</label>
              <%= grf.number_field :capital_controls, min: 0, class: "h-12 w-full rounded border border-gray-300 px-3 text-center text-sm leading-5",
                  data: { action: "input->points-calculator#calculate", points_calculator_target: "capitalControls" } %>
            </div>

            <div class="min-w-0">
              <label class="mb-1 block text-xs font-medium uppercase tracking-wide text-gray-500 lg:hidden">Земли</label>
              <%= grf.number_field :lands, min: 0, class: "h-12 w-full rounded border border-gray-300 px-3 text-center text-sm leading-5" %>
            </div>

            <% if @tour.game_format.tracks_skulls? %>
              <div class="min-w-0">
                <label class="mb-1 block text-xs font-medium uppercase tracking-wide text-gray-500 lg:hidden">Черепки</label>
                <%= grf.number_field :skulls, min: 0, class: "h-12 w-full rounded border border-gray-300 px-3 text-center text-sm leading-5" %>
              </div>
            <% end %>

            <% if @tour.game_format.tracks_dragons? %>
              <div class="min-w-0">
                <label class="mb-1 block text-xs font-medium uppercase tracking-wide text-gray-500 lg:hidden">Драконы</label>
                <%= grf.number_field :dragons, min: 0, value: gr.dragons || 0, class: "h-12 w-full rounded border border-gray-300 px-3 text-center text-sm leading-5",
                    data: { action: "input->points-calculator#calculate", points_calculator_target: "dragons" } %>
              </div>
            <% end %>

            <div class="min-w-0">
              <label class="mb-1 block text-xs font-medium uppercase tracking-wide text-gray-500 lg:hidden">Замки</label>
              <%= grf.number_field :castles, min: 0, value: gr.castles || 0, class: "h-12 w-full rounded border border-gray-300 px-3 text-center text-sm leading-5",
                  data: { action: "input->points-calculator#calculate", points_calculator_target: "castles" } %>
            </div>

            <div class="min-w-0">
              <label class="mb-1 block text-xs font-medium uppercase tracking-wide text-gray-500 lg:hidden">Подсказка</label>
              <div class="flex h-12 w-full items-center justify-center rounded border border-dashed border-gray-300 bg-gray-50 px-3 text-center text-sm leading-5 text-gray-500" data-points-calculator-target="suggested">
                <%= gr.persisted? && gr.place ? gr.suggested_points : "—" %>
              </div>
            </div>

            <div class="min-w-0">
              <label class="mb-1 block text-xs font-medium uppercase tracking-wide text-gray-500 lg:hidden">Очки</label>
              <%= grf.number_field :points, class: "h-12 w-full rounded border border-gray-300 px-3 text-center text-sm font-bold leading-5",
                  data: { action: "input->points-calculator#updateManualAdjustment", points_calculator_target: "points" } %>
            </div>

            <% if gr.persisted? && gr.using_legacy_capitals? %>
              <p class="col-span-2 mt-1 text-xs text-amber-700 lg:col-span-full" data-points-calculator-target="legacyNotice">
                Пока используются legacy-данные “Столицы”: <%= gr.capitals %>. Заполните новые поля, чтобы перейти на раздельный учёт.
              </p>
            <% end %>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>

  <div class="border-t px-4 py-4">
    <p class="mb-3 hidden rounded border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700" data-slot-toggle-target="formError"></p>
    <%= f.submit "Сохранить результаты", class: "w-full cursor-pointer rounded bg-gray-900 px-6 py-2 text-white hover:bg-gray-700 sm:w-auto" %>
  </div>
<% end %>
