<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-bold">Тур <%= @tour.number %></h1>
  <div class="flex items-center gap-4">
    <%= link_to "Редактировать", edit_admin_tour_path(@tour), class: "text-sm text-blue-600 hover:underline" %>
    <%= link_to "← Все туры", admin_tours_path, class: "text-gray-500 hover:text-gray-700 text-sm" %>
  </div>
</div>

<div class="grid gap-4 md:grid-cols-2">
  <% @games.each do |game| %>
    <div class="bg-white rounded shadow p-4">
      <div class="flex justify-between items-center mb-3">
        <h2 class="font-bold">Стол <%= game.table_letter %></h2>
        <%= link_to "Редактировать", edit_admin_tour_game_path(@tour, game), class: "text-sm text-blue-600 hover:underline" %>
      </div>
      <% if game.game_results.any? %>
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b text-gray-500">
              <th class="text-left py-1">Игрок</th>
              <th class="text-center py-1">М.</th>
              <th class="text-center py-1">Очки</th>
            </tr>
          </thead>
          <tbody>
            <% game.game_results.includes(:player).order(:place).each do |gr| %>
              <tr class="border-b border-gray-100">
                <td class="py-1"><%= gr.player.nickname %></td>
                <td class="text-center py-1"><%= gr.place %></td>
                <td class="text-center py-1 font-bold"><%= gr.points %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <p class="text-gray-400 text-sm">Нет результатов</p>
      <% end %>
    </div>
  <% end %>
</div>
