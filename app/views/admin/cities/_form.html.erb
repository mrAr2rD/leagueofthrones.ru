<%= form_with model: [:admin, city], class: "space-y-4 max-w-lg" do |f| %>
  <% if city.errors.any? %>
    <div class="bg-red-100 border border-red-300 text-red-800 px-4 py-2 rounded">
      <% city.errors.full_messages.each do |msg| %>
        <p><%= msg %></p>
      <% end %>
    </div>
  <% end %>

  <div>
    <%= f.label :name, "Название", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_field :name, class: "w-full border border-gray-300 rounded px-3 py-2" %>
  </div>

  <div>
    <%= f.label :slug, "Slug (в URL)", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_field :slug, class: "w-full border border-gray-300 rounded px-3 py-2" %>
    <p class="mt-1 text-xs text-gray-400">Только латиница, цифры и дефис. Пример: moscow → /moscow</p>
  </div>

  <div>
    <%= f.label :register_url, "Ссылка «Записаться»", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.url_field :register_url, class: "w-full border border-gray-300 rounded px-3 py-2" %>
  </div>

  <div>
    <%= f.label :default_format, "Формат по умолчанию", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.select :default_format, GameFormat.options, {}, class: "w-full border border-gray-300 rounded px-3 py-2" %>
    <p class="mt-1 text-xs text-gray-400">Определяет размер дивизионов лиг и формат новых туров</p>
  </div>

  <div>
    <%= f.label :position, "Позиция в списке", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.number_field :position, class: "w-full border border-gray-300 rounded px-3 py-2" %>
  </div>

  <div>
    <%= f.submit class: "bg-gray-900 text-white px-6 py-2 rounded hover:bg-gray-700 cursor-pointer" %>
  </div>
<% end %>
