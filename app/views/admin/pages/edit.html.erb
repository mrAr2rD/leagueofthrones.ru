<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-bold">Редактировать: <%= @page.title %></h1>
  <%= link_to "← Посмотреть на сайте", rules_path, target: "_blank", class: "text-blue-600 hover:underline text-sm" %>
</div>

<%= form_with model: @page, url: admin_page_path(@page.slug), method: :patch, class: "space-y-4" do |f| %>
  <% if @page.errors.any? %>
    <div class="bg-red-100 border border-red-300 text-red-800 px-4 py-2 rounded">
      <% @page.errors.full_messages.each do |msg| %>
        <p><%= msg %></p>
      <% end %>
    </div>
  <% end %>

  <div>
    <%= f.label :title, "Заголовок", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_field :title, class: "w-full border border-gray-300 rounded px-3 py-2" %>
  </div>

  <div>
    <%= f.label :content, "Содержание (текст с переносами строк)", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_area :content, rows: 40, class: "w-full border border-gray-300 rounded px-3 py-2 font-mono text-sm" %>
  </div>

  <div>
    <%= f.submit "Сохранить", class: "bg-gray-900 text-white px-6 py-2 rounded hover:bg-gray-700 cursor-pointer" %>
  </div>
<% end %>
