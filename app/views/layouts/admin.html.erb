<!DOCTYPE html>
<html>
  <head>
    <title>Админ — Игра Престолов</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-gray-50 min-h-screen overflow-x-hidden">
    <nav class="bg-gray-900 text-white">
      <div class="max-w-5xl mx-auto px-4 py-3">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
          <div class="min-w-0 flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-6">
            <span class="font-bold text-lg leading-tight">⚔️ Админ-панель</span>
            <% if current_admin %>
              <div class="flex flex-wrap items-center gap-x-6 gap-y-2 text-sm">
                <%= link_to "Города", admin_cities_path, class: "hover:text-yellow-300" %>
                <%= link_to "Игроки", admin_players_path, class: "hover:text-yellow-300" %>
                <%= link_to "Туры", admin_tours_path, class: "hover:text-yellow-300" %>
                <%= link_to "Страницы", admin_pages_path, class: "hover:text-yellow-300" %>
                <%= link_to "← На сайт", root_path, class: "hover:text-yellow-300" %>
              </div>
            <% end %>
          </div>

          <% if current_admin %>
            <div class="shrink-0">
              <%= button_to "Выйти", admin_logout_path, method: :delete, class: "text-sm text-red-300 hover:text-red-100", form_class: "inline-block" %>
            </div>
          <% end %>
        </div>
      </div>
    </nav>

    <div class="max-w-5xl mx-auto px-4 py-6 overflow-x-hidden">
      <% if flash[:notice] %>
        <div class="bg-green-100 border border-green-300 text-green-800 px-4 py-2 rounded mb-4"><%= flash[:notice] %></div>
      <% end %>
      <% if flash[:alert] %>
        <div class="bg-red-100 border border-red-300 text-red-800 px-4 py-2 rounded mb-4"><%= flash[:alert] %></div>
      <% end %>

      <%= yield %>
    </div>
  </body>
</html>
