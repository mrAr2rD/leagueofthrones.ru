<div class="max-w-md mx-auto px-3 py-16 torch-glow">

  <div class="pixel-box pixel-box-gold p-8">

    <div class="text-center mb-6">
      <h1 class="realm-title" style="font-size: 16px;">
        <span class="icon-shield"></span> Галерея
      </h1>
      <div class="pixel-chain" style="margin-top: 1rem;">
        <% 5.times do %><span class="pixel-chain-link"></span><% end %>
        <span class="pixel-chain-gem"></span>
        <% 5.times do %><span class="pixel-chain-link"></span><% end %>
      </div>
      <p class="realm-subtitle" style="font-size: 16px; margin-top: 0.75rem;">
        Назовите пароль, чтобы войти
      </p>
    </div>

    <% if flash[:alert] %>
      <div class="pixel-alert-error mb-4"><%= flash[:alert] %></div>
    <% end %>

    <%= form_with url: gallery_authenticate_path, method: :post, class: "pixel-form" do |f| %>
      <div class="pixel-form-group">
        <label class="pixel-form-label">Логин</label>
        <%= f.text_field :login, name: "login", class: "pixel-form-input", autofocus: true, autocomplete: "username" %>
      </div>
      <div class="pixel-form-group">
        <label class="pixel-form-label">Пароль</label>
        <%= f.password_field :password, name: "password", class: "pixel-form-input", autocomplete: "current-password" %>
      </div>
      <%= f.submit "Войти", class: "pixel-btn pixel-btn-gold w-full" %>
    <% end %>

    <div class="text-center mt-4">
      <%= link_to root_path, class: "pixel-back-link" do %>
        <span class="icon-sword"></span> Назад к таблице
      <% end %>
    </div>

  </div>

</div>
