<div class="max-w-3xl mx-auto px-3 py-6 torch-glow">

  <%# ── Back link ── %>
  <div class="mb-6">
    <%= link_to city_leaderboard_path(@city), class: "pixel-back-link" do %>
      <span class="icon-sword"></span> Назад к таблице
    <% end %>
  </div>

  <%= render "shared/city_switcher" %>

  <%# ── Player Card ── %>
  <div class="pixel-box pixel-box-gold p-6">

    <div class="text-center mb-6">
      <div class="player-card-avatar league-<%= @league %>">
        <% if @player.photo.attached? %>
          <%= image_tag @player.photo_large, alt: @player.nickname %>
        <% else %>
          <%= @player.initials %>
        <% end %>
      </div>
      <h1 class="player-card-name"><%= @player.display_name %></h1>
      <p class="player-card-nick"><%= @player.nickname %></p>

      <div class="pixel-chain" style="margin-top: 1.5rem;">
        <% 6.times do %><span class="pixel-chain-link"></span><% end %>
        <span class="pixel-chain-gem"></span>
        <% 6.times do %><span class="pixel-chain-link"></span><% end %>
      </div>
    </div>

    <% if @achievement_awards.any? %>
      <section class="player-achievements" data-testid="player-achievements">
        <h2 class="player-section-title"><span class="icon-crown"></span> Достижения</h2>
        <div class="player-achievement-grid">
          <% @achievement_awards.each do |award| %>
            <% definition = award.definition %>
            <article class="player-achievement-card" data-achievement-key="<%= award.achievement_key %>">
              <div class="player-achievement-icon" aria-hidden="true">
                <%= image_tag definition.icon_path, alt: "" %>
              </div>
              <div class="player-achievement-content">
                <h3 class="player-achievement-name"><%= definition.name %></h3>
                <p class="player-achievement-description"><%= definition.description %></p>
                <p class="player-achievement-meta">
                  <%= award.game_format_definition.label %> · результат: <strong><%= award.stat_value %></strong>
                </p>
              </div>
            </article>
          <% end %>
        </div>
      </section>
    <% end %>

    <%# ── Stats Summary ── %>
    <% if @results.any? %>
      <div class="player-summary-grid">
        <div class="player-summary-item">
          <span class="player-summary-value"><%= @results.size %></span>
          <span class="player-summary-label">Игры</span>
        </div>
        <div class="player-summary-item">
          <span class="player-summary-value"><%= @results.count { |r| r.place == 1 } %></span>
          <span class="player-summary-label">Победы</span>
        </div>
        <div class="player-summary-item">
          <span class="player-summary-value"><%= @results.sum { |r| r.points || 0 } %></span>
          <span class="player-summary-label">Очки</span>
        </div>
        <div class="player-summary-item">
          <span class="player-summary-value"><%= @results.sum(&:ranking_captures) %></span>
          <span class="player-summary-label">Захваты</span>
        </div>
        <% if @city.default_game_format.tracks_dragons? %>
          <div class="player-summary-item">
            <span class="player-summary-value"><%= @results.sum { |r| r.dragons || 0 } %></span>
            <span class="player-summary-label">Драконы</span>
          </div>
        <% end %>
        <div class="player-summary-item">
          <span class="player-summary-value"><%= @results.sum { |r| r.castles || 0 } %></span>
          <span class="player-summary-label">Замки</span>
        </div>
      </div>

      <%# ── Game History ── %>
      <h2 class="player-section-title"><span class="icon-shield"></span> Хроника битв</h2>

      <div class="league-table-wrap">
        <table class="player-stats-table">
          <colgroup>
            <col class="player-stats-col-tour">
            <col class="player-stats-col-table">
            <col class="player-stats-col-house">
            <col class="player-stats-col-place">
            <col class="player-stats-col-points">
            <col class="player-stats-col-stat">
            <% if @city.default_game_format.tracks_dragons? %>
              <col class="player-stats-col-stat">
            <% end %>
            <col class="player-stats-col-stat">
          </colgroup>
          <thead>
            <tr>
              <th class="player-stats-header-left">Тур</th>
              <th>Стол</th>
              <th class="player-stats-header-left">Дом</th>
              <th>
                <span class="player-stats-heading">
                  <span class="icon-shield"></span>
                  <span>Место</span>
                </span>
              </th>
              <th>Очки</th>
              <th>
                <span class="player-stats-heading-icon">
                  <span class="icon-capture"></span>
                </span>
              </th>
              <% if @city.default_game_format.tracks_dragons? %>
                <th>
                  <span class="player-stats-heading-icon">
                    <span class="icon-dragon"></span>
                  </span>
                </th>
              <% end %>
              <th>
                <span class="player-stats-heading-icon">
                  <span class="icon-castle"></span>
                </span>
              </th>
            </tr>
          </thead>
          <tbody>
            <% @results.each do |r| %>
              <tr>
                <td class="player-stats-tour"><%= r.game.tour.number %></td>
                <td><%= r.game.table_letter %></td>
                <td class="player-stats-house"><%= r.house_name || "—" %></td>
                <td class="player-stats-place-cell">
                  <% if r.place == 1 %>
                    <span class="player-stats-place player-stats-place-first">
                      <span class="icon-crown"></span>
                      <span><%= r.place %></span>
                    </span>
                  <% else %>
                    <span class="player-stats-place"><%= r.place %></span>
                  <% end %>
                </td>
                <td class="player-stats-points"><%= r.points %></td>
                <td><%= r.ranking_captures %></td>
                <% if @city.default_game_format.tracks_dragons? %>
                  <td><%= r.dragons %></td>
                <% end %>
                <td><%= r.castles %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="pixel-empty">Этот воин ещё не вступал в битву...</p>
    <% end %>
  </div>

</div>
