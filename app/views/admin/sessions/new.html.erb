<div class="max-w-sm mx-auto mt-20">
  <h1 class="text-2xl font-bold mb-6 text-center">Вход в админ-панель</h1>

  <%= form_with url: admin_login_path, method: :post, class: "space-y-4" do |f| %>
    <div>
      <%= f.label :login, "Логин", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :login, name: "login", class: "w-full border border-gray-300 rounded px-3 py-2", autofocus: true %>
    </div>
    <div>
      <%= f.label :password, "Пароль", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.password_field :password, name: "password", class: "w-full border border-gray-300 rounded px-3 py-2" %>
    </div>
    <%= f.submit "Войти", class: "w-full bg-gray-900 text-white py-2 rounded hover:bg-gray-700 cursor-pointer" %>
  <% end %>
</div>
