<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-bold">Редактировать: <%= @tour.city.name %> · Тур <%= @tour.number %></h1>
  <%= link_to "← Назад", admin_tour_path(@tour), class: "text-gray-500 hover:text-gray-700 text-sm" %>
</div>

<%= render "form", tour: @tour %>

<%= button_to "Удалить тур", admin_tour_path(@tour), method: :delete,
    form: { data: { turbo_confirm: "Удалить тур и все его результаты?" }, class: "mt-6" },
    class: "text-sm text-red-600 hover:underline bg-transparent border-0 p-0 cursor-pointer" %>
