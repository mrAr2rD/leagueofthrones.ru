<h1 class="text-2xl font-bold mb-6">Туры</h1>

<div class="grid gap-4 md:grid-cols-2 lg:grid-cols-4">
  <% @tours.each do |tour| %>
    <div class="bg-white rounded shadow p-4 hover:shadow-lg transition">
      <%= link_to admin_tour_path(tour), class: "block" do %>
        <h2 class="font-bold text-lg">Тур <%= tour.number %></h2>
        <p class="text-sm text-gray-500 mt-1">
          <%= tour.played_on ? tour.played_on.strftime("%d.%m.%Y") : "Дата не назначена" %>
        </p>
        <p class="text-sm text-gray-400 mt-1">
          <%= tour.games.flat_map(&:game_results).count { |gr| gr.points.present? } %> результатов
        </p>
      <% end %>
      <div class="mt-2">
        <%= link_to "Редактировать", edit_admin_tour_path(tour), class: "text-sm text-blue-600 hover:underline" %>
      </div>
    </div>
  <% end %>
</div>
