<%# ═══════════════════════════════════════════
    MEDIEVAL PIXEL-ART TOURNAMENT LEADERBOARD
    ═══════════════════════════════════════════ %>

<div class="max-w-5xl mx-auto px-3 py-6 torch-glow" data-controller="row-click">

  <%# ── HEADER ── %>
  <header class="realm-header">
    <h1 class="realm-title" style="display: flex; align-items: center; justify-content: center; gap: 0.5em;">
      <span style="filter: brightness(1.2) saturate(1.5);">&#x1F451;</span>
      Игра Престолов
      <span style="filter: brightness(1.2) saturate(1.5);">&#x1F451;</span>
    </h1>
    <div class="pixel-chain">
      <% 8.times do %><span class="pixel-chain-link"></span><% end %>
      <span class="pixel-chain-gem"></span>
      <% 8.times do %><span class="pixel-chain-link"></span><% end %>
    </div>
    <p class="realm-subtitle">LEAGUE OF THRONES</p>
  </header>

  <%# ── NAV ── %>
  <nav class="flex justify-center gap-3 mb-6">
    <%= link_to rules_path, class: "tour-scroll tour-scroll-active" do %>
      &#x1F4DC; Правила
    <% end %>
    <a href="https://t.me/aesmic" target="_blank" rel="noopener noreferrer" class="tour-scroll tour-scroll-active">
      &#x270D;&#xFE0F; Записаться
    </a>
  </nav>

  <%# ── TOUR BADGES ── %>
  <% if @tours.any? %>
    <p class="text-center mb-2" style="color: var(--gold); font-family: var(--font-pixel, monospace); font-size: 0.85rem; letter-spacing: 0.1em;">РАСПИСАНИЕ ТУРОВ</p>
    <div class="flex justify-center gap-2 mb-6 flex-wrap">
      <% @tours.each do |tour| %>
        <span class="tour-scroll <%= 'tour-scroll-active' if tour.played_on %>">
          &#x2694;&#xFE0F;
          <%= tour.number %><%= " - #{tour.played_on.strftime('%d.%m')}" if tour.played_on %>
        </span>
      <% end %>
    </div>
  <% end %>

  <%# ── LEAGUE LEGEND ── %>
  <div class="league-legend" style="margin-top: 0; margin-bottom: 1rem;">
    <% league_data = { gold: ["#e8b830", "Золотая"], silver: ["#b0b8c8", "Серебряная"], bronze: ["#c87830", "Бронзовая"], iron: ["#5a5a6a", "Железная"] } %>
    <% league_data.each do |_key, (color, label)| %>
      <span class="legend-item">
        <span class="legend-swatch" style="background-color: <%= color %>;"></span>
        <%= label %> лига
      </span>
    <% end %>
  </div>

  <%# CHIBI SCENE removed %>

  <%# ── MAIN TABLE ── %>
  <div class="pixel-box pixel-box-gold p-0 overflow-hidden">
    <div class="league-table-wrap">
      <table class="league-table">
        <thead>
          <tr>
            <th class="text-left" style="width: 50px;">#</th>
            <th class="text-left" style="width: 50px;"></th>
            <th class="text-left">Лорд</th>
            <th class="text-center">Очки</th>
            <th class="text-center hide-mobile">&#x2694;&#xFE0F; Игры</th>
            <th class="text-center hide-mobile"><span class="icon-crown"></span> Победы</th>
            <th class="text-center hide-mobile">&#x1F3F0; Захваты</th>
            <th class="text-center hide-mobile">&#x1F432; Драконы</th>
            <th class="text-center" style="width: 60px;">Ротация</th>
          </tr>
        </thead>
        <tbody>
          <% prev_league = nil %>
          <% @rankings.each do |rp| %>
            <% league_key = rp.league %>
            <% league = RankingCalculator::LEAGUES[league_key] %>

            <%# League divider %>
            <% if prev_league && prev_league != league_key %>
              <tr class="league-divider"><td colspan="9"></td></tr>
            <% end %>
            <% prev_league = league_key %>

            <tr class="league-row-<%= league_key %>"
                data-action="click->row-click#open"
                data-row-click-url-param="<%= player_path(rp.player) %>">

              <%# Rank %>
              <td>
                <span class="rank-num <%= 'rank-crown' if rp.rank <= 3 %>">
                  <%= rp.rank %>
                </span>
              </td>

              <%# Avatar %>
              <td>
                <div class="pixel-avatar">
                  <% if rp.player.photo.attached? %>
                    <%= image_tag rp.player.photo_thumbnail, alt: rp.player.nickname %>
                  <% else %>
                    <%= rp.player.initials %>
                  <% end %>
                </div>
              </td>

              <%# Name %>
              <td>
                <div class="player-name"><%= rp.player.nickname&.delete_prefix("@") %></div>
                <div class="player-nick"><%= rp.player.display_name %></div>
              </td>

              <%# Points %>
              <td class="text-center">
                <span class="score-points"><%= rp.best6_points %></span>
              </td>

              <%# Stats %>
              <td class="stat-cell hide-mobile"><%= rp.games_played %></td>
              <td class="stat-cell hide-mobile"><%= rp.wins %></td>
              <td class="stat-cell hide-mobile"><%= rp.capitals %></td>
              <td class="stat-cell hide-mobile"><%= rp.dragons %></td>

              <%# Rank change %>
              <td class="text-center">
                <% if rp.rank_change.nil? || rp.rank_change == 0 %>
                  <span class="rank-same">- - -</span>
                <% elsif rp.rank_change > 0 %>
                  <span class="rank-up">+<%= rp.rank_change %></span>
                <% else %>
                  <span class="rank-down"><%= rp.rank_change %></span>
                <% end %>
              </td>
            </tr>
          <% end %>

          <%# ── FREE SLOTS in Iron League ── %>
          <% last_rank = @rankings.any? ? @rankings.last.rank : 0 %>
          <tr class="league-divider"><td colspan="9"></td></tr>
          <% 4.times do |i| %>
            <tr class="league-row-iron">
              <td><span class="rank-num"><%= last_rank + i + 1 %></span></td>
              <td><div class="pixel-avatar" style="opacity: 0.4;">?</div></td>
              <td><div class="player-name" style="opacity: 0.5; font-style: italic;">СВОБОДНО</div></td>
              <td class="text-center"><span class="score-points">—</span></td>
              <td class="stat-cell hide-mobile">—</td>
              <td class="stat-cell hide-mobile">—</td>
              <td class="stat-cell hide-mobile">—</td>
              <td class="stat-cell hide-mobile">—</td>
              <td class="text-center"><span class="rank-same">—</span></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

</div>
