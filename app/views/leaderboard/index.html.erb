<%# ═══════════════════════════════════════════
    MEDIEVAL PIXEL-ART TOURNAMENT LEADERBOARD
    ═══════════════════════════════════════════ %>

<div class="max-w-5xl mx-auto px-3 py-6 torch-glow" data-controller="row-click">

  <%# ── HEADER ── %>
  <header class="realm-header">
    <h1 class="realm-title">Игра Престолов</h1>
    <div class="pixel-chain">
      <% 8.times do %><span class="pixel-chain-link"></span><% end %>
      <span class="pixel-chain-gem"></span>
      <% 8.times do %><span class="pixel-chain-link"></span><% end %>
    </div>
    <p class="realm-subtitle">LEAGUE OF THRONES</p>
  </header>

  <%# ── CITY SWITCHER ── %>
  <%= render "shared/city_switcher" %>

  <%# ── NAV ── %>
  <nav class="flex justify-center gap-3 mb-6">
    <%= link_to city_rules_path(@city), class: "tour-scroll tour-scroll-active", style: "min-width: 120px; text-align: center; justify-content: center;" do %>
      Правила
    <% end %>
    <% if @city.register_url.present? %>
      <a href="<%= @city.register_url %>" target="_blank" rel="noopener noreferrer" class="tour-scroll tour-scroll-active" style="min-width: 120px; text-align: center; justify-content: center;">
        Записаться
      </a>
    <% end %>
  </nav>

  <%# ── TOUR BADGES ── %>
  <% if @tours.any? %>
    <p class="text-center mb-2" style="color: var(--gold); font-family: var(--font-pixel, monospace); font-size: 0.85rem; letter-spacing: 0.1em;">РАСПИСАНИЕ ТУРОВ</p>
    <div class="flex justify-center gap-2 mb-6 flex-wrap items-stretch">
      <%= link_to city_leaderboard_path(@city), class: "tour-scroll #{'tour-scroll-selected' unless @selected_tour} tour-scroll-active", style: "text-decoration: none; text-align: center; display: inline-flex; align-items: center; align-self: stretch;" do %>
        &#x1F3C6; Рейтинг
      <% end %>
      <% @tours.each do |tour| %>
        <% selected = @selected_tour&.id == tour.id %>
        <% tour_url = selected ? city_leaderboard_path(@city) : city_leaderboard_path(@city, tour: tour.number) %>
        <%= link_to tour_url, class: "tour-scroll #{'tour-scroll-selected' if selected} #{'tour-scroll-active' if tour.played_on}", style: "text-decoration: none; text-align: center;" do %>
          &#x2694;&#xFE0F; <%= tour.number %>
          <% if tour.date_range_label %>
            <br><%= tour.date_range_label %>
          <% elsif tour.played_on %>
            <br><%= tour.played_on.strftime('%d.%m') %>
          <% end %>
        <% end %>
      <% end %>
    </div>
  <% end %>

  <% if @selected_tour %>
    <%# ── TOUR DETAIL ── %>
    <% @games.each do |game| %>
      <p class="text-center mb-2" style="color: var(--gold); font-family: var(--font-pixel, monospace); font-size: 0.85rem; letter-spacing: 0.1em;">
        СТОЛ <%= game.table_letter %>
        <% unless @selected_tour.played? %>
          <span style="color: var(--parchment); opacity: 0.5;"> — ещё не сыгран</span>
        <% end %>
      </p>

      <% results = game.game_results.sort_by { |gr| gr.place || 999 } %>
      <div class="pixel-box pixel-box-gold p-0 overflow-hidden mb-6">
        <% if results.any? %>
          <div class="league-table-wrap">
            <table class="league-table">
              <thead>
                <tr>
                  <th class="text-left" style="width: 50px;">#</th>
                  <th class="text-left" style="width: 50px;"></th>
                  <th class="text-left">Лорд</th>
                  <th class="text-center">Очки</th>
                  <th class="text-center hide-mobile">Дом</th>
                  <th class="text-center hide-mobile">Захваты</th>
                  <% if @selected_tour.game_format.tracks_dragons? %>
                    <th class="text-center hide-mobile">Драконы</th>
                  <% end %>
                  <th class="text-center hide-mobile">Замки</th>
                </tr>
              </thead>
              <tbody>
                <% results.each do |gr| %>
                  <tr data-action="click->row-click#open"
                      data-row-click-url-param="<%= city_player_path(@city, gr.player) %>">
                    <td>
                      <% if gr.place %>
                        <span class="rank-num <%= 'rank-crown' if gr.place <= 3 %>"><%= gr.place %></span>
                      <% else %>
                        <span style="color: var(--parchment); opacity: 0.5;">—</span>
                      <% end %>
                    </td>
                    <td>
                      <div class="pixel-avatar">
                        <% if gr.player.photo.attached? %>
                          <%= image_tag gr.player.photo_thumbnail, alt: gr.player.nickname %>
                        <% else %>
                          <%= gr.player.initials %>
                        <% end %>
                      </div>
                    </td>
                    <td>
                      <div class="player-name"><%= gr.player.nickname&.delete_prefix("@") %></div>
                      <div class="player-nick"><%= gr.player.display_name %></div>
                    </td>
                    <td class="text-center">
                      <% if gr.points %>
                        <span class="score-points"><%= gr.points %></span>
                      <% else %>
                        <span style="color: var(--parchment); opacity: 0.5;">—</span>
                      <% end %>
                    </td>
                    <td class="stat-cell hide-mobile"><%= gr.house_name %></td>
                    <td class="stat-cell hide-mobile"><%= gr.capital_captures || gr.capitals || 0 %></td>
                    <% if @selected_tour.game_format.tracks_dragons? %>
                      <td class="stat-cell hide-mobile"><%= gr.dragons || 0 %></td>
                    <% end %>
                    <td class="stat-cell hide-mobile"><%= gr.castles || 0 %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <p class="text-center py-4" style="color: var(--parchment); opacity: 0.5; font-family: var(--font-pixel, monospace); font-size: 0.8rem;">
            Нет участников
          </p>
        <% end %>
      </div>
    <% end %>

  <% else %>
    <%# ── LEAGUE LEGEND ── %>
    <div class="league-legend" style="margin-top: 0; margin-bottom: 1rem;">
      <% league_data = { gold: ["#e8b830", "Золотая"], silver: ["#b0b8c8", "Серебряная"], bronze: ["#c87830", "Бронзовая"], iron: ["#5a5a6a", "Железная"] } %>
      <% league_data.each do |_key, (color, label)| %>
        <span class="legend-item">
          <span class="legend-swatch" style="background-color: <%= color %>;"></span>
          <%= label %> лига
        </span>
      <% end %>
    </div>

    <%# ── MAIN TABLE ── %>
    <div class="pixel-box pixel-box-gold p-0 overflow-hidden">
      <div class="league-table-wrap">
        <table class="league-table">
          <thead>
            <tr>
              <th class="text-left" style="width: 50px;">#</th>
              <th class="text-left" style="width: 50px;"></th>
              <th class="text-left">Лорд</th>
              <th class="text-center">Очки</th>
              <th class="text-center hide-mobile">Игры</th>
              <th class="text-center hide-mobile">Победы</th>
              <th class="text-center hide-mobile">Захваты</th>
              <% if @city.default_game_format.tracks_dragons? %>
                <th class="text-center hide-mobile">Драконы</th>
              <% end %>
              <th class="text-center" style="width: 60px;">Прирост</th>
            </tr>
          </thead>
          <tbody>
            <% prev_league = nil %>
            <% @rankings.each do |rp| %>
              <% league_key = rp.league %>
              <% league = RankingCalculator::LEAGUES[league_key] %>

              <%# League divider %>
              <% if prev_league && prev_league != league_key %>
                <tr class="league-divider"><td colspan="<%= @city.default_game_format.tracks_dragons? ? 9 : 8 %>"></td></tr>
              <% end %>
              <% prev_league = league_key %>

              <tr class="league-row-<%= league_key %>"
                  data-action="click->row-click#open"
                  data-row-click-url-param="<%= city_player_path(@city, rp.player) %>">

                <%# Rank %>
                <td>
                  <span class="rank-num <%= 'rank-crown' if rp.rank <= 3 %>">
                    <%= rp.rank %>
                  </span>
                </td>

                <%# Avatar %>
                <td>
                  <div class="pixel-avatar">
                    <% if rp.player.photo.attached? %>
                      <%= image_tag rp.player.photo_thumbnail, alt: rp.player.nickname %>
                    <% else %>
                      <%= rp.player.initials %>
                    <% end %>
                  </div>
                </td>

                <%# Name %>
                <td>
                  <div class="player-name"><%= rp.player.nickname&.delete_prefix("@") %></div>
                  <div class="player-nick"><%= rp.player.display_name %></div>
                </td>

                <%# Points %>
                <td class="text-center">
                  <span class="score-points"><%= rp.best6_points %></span>
                </td>

                <%# Stats %>
                <td class="stat-cell hide-mobile"><%= rp.games_played %></td>
                <td class="stat-cell hide-mobile"><%= rp.wins %></td>
                <td class="stat-cell hide-mobile"><%= rp.captures %></td>
                <% if @city.default_game_format.tracks_dragons? %>
                  <td class="stat-cell hide-mobile"><%= rp.dragons %></td>
                <% end %>

                <%# Last tour points %>
                <td class="text-center">
                  <% if rp.last_tour_points.nil? || rp.last_tour_points == 0 %>
                    <span class="rank-same">—</span>
                  <% else %>
                    <span class="rank-up">+<%= rp.last_tour_points %></span>
                  <% end %>
                </td>
              </tr>
            <% end %>

          </tbody>
        </table>
      </div>
    </div>
  <% end %>

</div>
