<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-bold">Страницы</h1>
  <%= link_to "Добавить страницу", new_admin_page_path, class: "inline-flex items-center justify-center rounded bg-gray-900 px-4 py-2 text-sm text-white hover:bg-gray-700" %>
</div>

<div class="space-y-3">
  <% @pages.each do |page| %>
    <div class="flex items-center justify-between rounded border border-gray-200 bg-white px-4 py-3">
      <div class="min-w-0">
        <h2 class="font-bold text-lg"><%= page.title %></h2>
        <p class="text-sm text-gray-500"><%= page.city.name %> · /<%= page.slug %></p>
      </div>
      <%= link_to "Ред.", edit_admin_page_path(page), class: "text-sm text-blue-600 hover:underline shrink-0" %>
    </div>
  <% end %>

  <% if @pages.empty? %>
    <p class="text-gray-500">Страниц пока нет.</p>
  <% end %>
</div>
