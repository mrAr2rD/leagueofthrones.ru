<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-bold">Новая страница</h1>
  <%= link_to "← Назад", admin_pages_path, class: "text-gray-500 hover:text-gray-700 text-sm" %>
</div>

<%= form_with model: @page, url: admin_pages_path, class: "space-y-4 max-w-2xl" do |f| %>
  <% if @page.errors.any? %>
    <div class="bg-red-100 border border-red-300 text-red-800 px-4 py-2 rounded">
      <% @page.errors.full_messages.each do |msg| %>
        <p><%= msg %></p>
      <% end %>
    </div>
  <% end %>

  <div>
    <%= f.label :city_id, "Город", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.collection_select :city_id, accessible_cities, :id, :name, {}, class: "w-full border border-gray-300 rounded px-3 py-2" %>
  </div>

  <div>
    <%= f.label :slug, "Slug (в URL)", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_field :slug, class: "w-full border border-gray-300 rounded px-3 py-2" %>
    <p class="mt-1 text-xs text-gray-400">Публично доступна только страница со slug «rules» (/:city/rules)</p>
  </div>

  <div>
    <%= f.label :title, "Заголовок", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_field :title, class: "w-full border border-gray-300 rounded px-3 py-2" %>
  </div>

  <div>
    <%= f.label :content, "Содержание (текст с переносами строк)", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_area :content, rows: 20, class: "w-full border border-gray-300 rounded px-3 py-2 font-mono text-sm" %>
  </div>

  <div>
    <%= f.submit "Создать", class: "bg-gray-900 text-white px-6 py-2 rounded hover:bg-gray-700 cursor-pointer" %>
  </div>
<% end %>
